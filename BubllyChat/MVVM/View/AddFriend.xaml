<Window x:Class="BubllyChat.MVVM.View.AddFriend"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BubllyChat.MVVM.View"
        xmlns:vm="clr-namespace:BubllyChat.MVVM.ViewModel"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="AddFriend" Height="300" Width="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="#2f3136"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Window.DataContext>
        <vm:FriendandRoomVM/>
    </Window.DataContext>

    <Grid Background="#2f3136">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#FF5E4AC3" Height="30">
            <Button x:Name="btnClose"
                    BorderThickness="0"
                    Cursor="Hand"
                    Content="x"
                    HorizontalAlignment="Right"
                    Click="btnClose_Click">



                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" 
                    Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#28AEED" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="40" Height="35"
                    Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
        </Border>
        <StackPanel Grid.Row="1">

            <TextBox Text="{Binding SearchText}"
                      FontSize="25"
                      FontWeight="Bold"
                      Foreground="White"
                      VerticalAlignment="Center"
                      Background="Transparent"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{Binding ColorStatusMessage}"
                       FontSize="12"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0 7 0 0"
                       Padding="60 0 0 0"/>
        </StackPanel>

        <Grid Grid.Row="2">


            <TabControl Background="#2f3136">
                <TabItem Header="Friends" Style="{StaticResource TabItemMainStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="btnAddFriend"
                                Grid.Row="1"
                                HorizontalAlignment="Right"
                                Content="Add Friend">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FF956AF7"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF89599C" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="90" Height="35"
                                    Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>

                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                        </Button>
                    </Grid>
                </TabItem>
                <TabItem Header="Rooms" Style="{StaticResource TabItemMainStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Border Width="100"
                                    Height="100"
                                    CornerRadius="90"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    BorderBrush="#FF7624B1"
                                    BorderThickness="3">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AvatarUrl}"/>
                                </Border.Background>
                                <Border CornerRadius="90"
                                        Width="30"
                                        Height="30"
                                        Background="White"
                                        BorderBrush="Black"
                                        BorderThickness="3"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Right">
                                    <Button x:Name="btnChooseAvt"
                                            Command="{Binding UploadAvatar}"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Style="{StaticResource tboxButton}"
                                            Background="Transparent"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <Icon:PackIconMaterial Kind="Camera"
                                                               Width="20"
                                                               Height="20"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Padding="0 0 2 0"/>
                                    </Button>

                                </Border>
                            </Border>

                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Grid.Row="1">
                            <Button x:Name="btnJoinRoom"
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    Command="{Binding JoinRoom}"
                                    Content="Join">

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#FF956AF7"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF89599C" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Width="90" Height="35"
                                    Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>

                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                            </Button>
                            <Button x:Name="btnCreateRoom"
                                    Command="{Binding CreateRoom}"
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    Content="Create">

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#FF956AF7"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF89599C" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Width="90" Height="35"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>

                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>

            </TabControl>


        </Grid>
    </Grid>



</Window>
