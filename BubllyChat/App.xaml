<Application x:Class="BubllyChat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BubllyChat"
             xmlns:converters="clr-namespace:BubllyChat.Core"
             
             StartupUri="MVVM\View\LoginView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Core/DataTemplate.xaml"/>
                <ResourceDictionary Source="Styles/ChatItem.xaml"/>
                <ResourceDictionary Source="Styles/ContactCard.xaml"/>
                <ResourceDictionary Source="Styles/TabItem.xaml"/>
                <ResourceDictionary Source="/Core/DataTemplate.xaml"/>
                <ResourceDictionary Source="Styles/Page.xaml"/>
                <ResourceDictionary Source="Styles/WindowPage.xaml"/>
                <ResourceDictionary Source="Styles/MessageBox.xaml"/>
                <ResourceDictionary Source="Styles/Text.xaml"/>
                <ResourceDictionary Source="Styles/Button.xaml"/>
                <ResourceDictionary Source="Styles/NavigateButton.xaml"/>
                <ResourceDictionary Source="Styles/textboxButton.xaml"/>
                <ResourceDictionary Source="Styles/StylishScrollBar.xaml"/>
                <ResourceDictionary Source="Styles/WindowButton.xaml"/>


            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
